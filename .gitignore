.hugo_build.lock
.parcel-cache
node_modules/
resources/

# ReScript のビルド成果物
lib/
rescript/*.js

# Tailwind CLI (build.sh) の出力。hugo は fingerprint をかけて配信するだけ。
assets/css/generated.css

# Hull.js (https://github.com/AndriiHeonia/hull) のベンダリング実体。
# 生成物ではないので追跡する。出典とライセンスはファイル冒頭にある。
# build.sh がこれを static/js へ cp するため、追跡していないと新規クローンでビルドできない。
!rescript/concave-hull.js

# サイトのビルド成果物。CI (.github/workflows/static.yml) が生成してデプロイする。
public/

# static/ はソースと生成物が混在している。static/css と static/image は手書きなので
# 追跡し、parcel の出力先である static/js だけを除外する。
static/js/
